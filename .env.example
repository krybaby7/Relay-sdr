# Never commit this file after adding secrets. All API credentials stay on the server.
HOST=127.0.0.1
PORT=8080
# Leave blank to generate a local login token at first startup.
ADMIN_TOKEN=
DATA_DIR=.data
OPENAI_API_KEY=
LIVE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-5.6-terra
# Browser voice tests use your API key but do not dial a phone number.
ENABLE_OUTBOUND=false
# Set only after configuring a public HTTPS endpoint and reviewing the pilot rules.
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Required for this pilot: only these E.164 numbers may receive a real phone call.
ALLOWED_NUMBERS=
MAX_CALL_SECONDS=180
MAX_DAILY_CALLS=10
MAX_CONCURRENT_CALLS=1
# Optional: receive leads from your own CRM/automation server, without giving it admin access.
INBOUND_LEAD_TOKEN=
# Optional: publish approved outcomes to a fixed HTTPS webhook (never chosen by the model).
OUTCOME_WEBHOOK_URL=
OUTCOME_WEBHOOK_SECRET=

# Independent post-call workspace reasoning. Never falls back to OPENAI_API_KEY.
# Enabling this sends relevant captured real-call text/human notes to OpenAI.
# Manual workspace editing works without enabling reasoning. Restart after changes.
WORKSPACE_ENABLED=false
WORKSPACE_API_KEY=
# Choose a Responses model supporting strict Structured Outputs in your project.
WORKSPACE_MODEL=
WORKSPACE_TIMEZONE=UTC
WORKSPACE_POLL_SECONDS=1
WORKSPACE_SETTLE_SECONDS=3
WORKSPACE_CHUNK_CHARS=24000
WORKSPACE_MAX_CHUNKS=4
WORKSPACE_TIMEOUT=45
WORKSPACE_OUTPUT_TOKENS=6000
WORKSPACE_DAILY_REQUESTS=100
WORKSPACE_DAILY_TOKENS=1500000
# Workspace graph invocation explicitly disables remote tracing as well.
LANGSMITH_TRACING=false
